# SQLite is local development only. Docker Compose uses PostgreSQL/pgvector.
DATABASE_URL=sqlite:///.data/atlas.db
AUTH_MODE=local
STORAGE_MODE=local
DATA_DIR=.data
PROVIDER_MODE=live
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=whisper-1
# Optional image-capable model for scans; a separate OCR product is not required.
# URL/key may match LLM if the selected model supports image input.
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
# Disabled by default. Enable only in the networkless renderer worker container.
RENDER_ENABLED=false
ADMIN_EMAIL=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
