FROM python:3.11-slim
WORKDIR /app
COPY pyproject.toml ./
COPY packages ./packages
COPY services ./services
COPY requirements.lock ./
RUN pip install --no-cache-dir -r requirements.lock && pip install --no-cache-dir --no-deps .
COPY knowledge ./knowledge
COPY apps/web/public/gtm-overview ./apps/web/public/gtm-overview
COPY apps/web/src/content/gtm-glossary.json ./apps/web/src/content/gtm-glossary.json
COPY profiles ./profiles
COPY skills ./skills
COPY templates ./templates
COPY infra ./infra
COPY alembic.ini ./
RUN useradd -m -u 10001 atlas && mkdir -p /data/artifacts /data/render-queue && chown -R atlas:atlas /data
USER atlas
ENV DATA_DIR=/data
CMD ["sh", "-c", "python -m alembic upgrade head && uvicorn services.api.main:app --host 0.0.0.0 --port 8000"]
